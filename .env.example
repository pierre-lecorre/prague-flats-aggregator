# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ollama LLM
OLLAMA_MODEL=llama3
MIN_SCORE=60

# Two commute anchors (lat,lon) — MOTIS public transit
COMMUTE_POINT_A_NAME=Palmovka
COMMUTE_POINT_A=50.1067,14.4639
COMMUTE_POINT_B_NAME=Muzeum
COMMUTE_POINT_B=50.0796,14.4309
COMMUTE_MAX_MINUTES=40
# Mapy.cz walking fallback (same as landomo-scraper). Transit uses MOTIS.
# Key: https://developer.mapy.com/account/
MAPY_API_KEY=
MAPY_ROUTE_TYPE=foot_fast

# Flat criteria (also sent to the LLM)
MIN_SIZE_M2=25
MAX_PRICE_CZK=20000
MIN_BEDROOMS=1
PREFERRED_DISTRICTS=
CRITERIA_NOTES=Whole apartment only. No flatshare, no room rental, no auction. Long-term Prague rental.
MAX_LISTING_AGE_HOURS=24
# Monthly poplatky if the listing does not mention fees (LLM extracts when present)
DEFAULT_MONTHLY_FEES_CZK=4000

# Landomo search page (Playwright intercepts the API)
LANDOMO_SEARCH_URL=https://landomo.cz/en/search?cat=flat&type=rent&pmax=20000&pcur=CZK&amin=25&q=Praha&bn=50.127&bs=50.06&be=14.511&bw=14.347

# Run mode
DRY_RUN=false

# TLS. Set false only behind a corporate SSL intercept.
HTTP_SSL_VERIFY=true
