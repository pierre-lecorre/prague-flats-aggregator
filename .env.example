# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ollama LLM Configuration
OLLAMA_MODEL=llama3

# Commute target
COMMUTE_TARGET_ADDRESS="Palmovka, Prague"
COMMUTE_MAX_MINUTES=40

# Flat criteria
MIN_SIZE_M2=25
MAX_PRICE_CZK=20000

# Run mode
DRY_RUN=false
