# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: OpenAI or other LLM for AI evaluation (if using external API)
# OPENAI_API_KEY=your_openai_api_key_here

# Commute target
COMMUTE_TARGET_ADDRESS="Palmovka, Prague"
COMMUTE_MAX_MINUTES=40

# Flat criteria
MIN_SIZE_M2=25
MAX_PRICE_CZK=20000

# Run mode
DRY_RUN=false
